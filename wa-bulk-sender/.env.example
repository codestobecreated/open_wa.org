# =====================================================================
#  Copy this file to ".env" and fill in the values marked  <-- CHANGE
#  NEVER commit .env or share it - it holds your API key.
# =====================================================================

# ---------- OpenWA connection ----------
OPENWA_URL=http://localhost:2785
# Dashboard -> API Keys -> create a key with role OPERATOR, paste it here        <-- CHANGE
OPENWA_API_KEY=PASTE-YOUR-API-KEY-HERE
# The session name you created in the dashboard (or its long id)                <-- CHANGE
OPENWA_SESSION=travel-promo

# ---------- Modes ----------
# true = only print what would be sent, nothing goes out
DRY_RUN=false
# true = send only to the first TEST_MODE_COUNT contacts (use your own numbers first)
TEST_MODE=false
TEST_MODE_COUNT=2

# ---------- Phone cleaning ----------
DEFAULT_COUNTRY_CODE=91
# Length of a local number WITHOUT the country code (India = 10)
LOCAL_NUMBER_LENGTH=10

# ---------- Message ----------
MESSAGE_FILE=message.txt
# Optional extra versions, separated by a line with only ---  (delete the file to use one text)
VARIANTS_FILE=message_variants.txt
# Used when a contact has no name: "Hi there"
NAME_FALLBACK=there
# Added to every message that does not already say "Reply STOP"
UNSUBSCRIBE_FOOTER=Reply STOP to unsubscribe

# ---------- Safety / pacing ----------
MIN_DELAY_SECONDS=8
MAX_DELAY_SECONDS=20
BATCH_SIZE=30
BATCH_BREAK_MINUTES=10
DAILY_LIMIT=150
# Only send between these hours (24h clock, your PC's time). TEST_MODE ignores this.
SEND_HOUR_START=9
SEND_HOUR_END=20
# Ask OpenWA whether each number is on WhatsApp before sending (skips dead numbers)
CHECK_NUMBERS=true

# ---------- Errors / retries ----------
MAX_RETRIES=3
# How long to wait for a disconnected session to come back before stopping
SESSION_WAIT_MINUTES=10
# Stop the run after this many failures in a row (something is wrong)
MAX_CONSECUTIVE_FAILURES=5

# ---------- STOP webhook receiver (npm run webhook) ----------
WEBHOOK_PORT=3000
# Any random text, at least 16 characters. OpenWA signs every call with it (HMAC). <-- CHANGE
WEBHOOK_SECRET=CHANGE-ME-to-a-long-random-text-1234567890
# How OpenWA (inside Docker) reaches your PC. Leave as is on Docker Desktop.
WEBHOOK_PUBLIC_URL=http://host.docker.internal:3000/openwa-webhook
# Send a short confirmation when someone replies STOP
SEND_STOP_CONFIRMATION=true
STOP_CONFIRMATION_TEXT=You have been unsubscribed and will not receive further messages from us.

# ---------- Later: database connection (see src/dataSource.js) ----------
# DB_URL=mysql://USER:PASSWORD@localhost:3306/DATABASE
# DB_URL=postgres://USER:PASSWORD@localhost:5432/DATABASE
# MONGO_URL=mongodb://localhost:27017
# MONGO_DB=travel
